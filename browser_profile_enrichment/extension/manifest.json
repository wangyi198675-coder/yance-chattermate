{
  "manifest_version": 3,
  "name": "Yance Browser-Assisted Profile Enrichment",
  "version": "0.1.0",
  "description": "User-invoked, current-tab-only Messenger profile enrichment for Yance.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Read visible Messenger profile for Yance"
  },
  "background": {
    "service_worker": "background.js"
  }
}
